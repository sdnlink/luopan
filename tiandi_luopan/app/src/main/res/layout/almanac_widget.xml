<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="#121216">
<TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#EDD176" android:textSize="18sp" />
<TextView android:id="@+id/widget_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#EEEEEE" android:textSize="13sp" />
<ProgressBar android:id="@+id/widget_term_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:max="100" android:progressTint="#EDD176" />
<TextView android:id="@+id/widget_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#BBBBBB" android:textSize="11sp" />
</LinearLayout>
