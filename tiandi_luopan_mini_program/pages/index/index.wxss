/* pages/index/index.wxss */

.page-container {
  min-height: 100vh;
  background-color: #12131a;
  color: #e0e0e0;
  display: flex;
  flex-direction: column;
  align-items: center;
  /* 顶部内边距交由 .custom-nav 的 padding-top 处理，避免与状态栏留白叠加；
     底部叠加安全区，避免全面屏机型的 Home Indicator 遮挡内容 */
  padding: 0 12rpx calc(40rpx + env(safe-area-inset-bottom));
}

/* 自定义顶部导航栏（navigationStyle: custom 时由页面自行渲染） */
.custom-nav {
  width: 100%;
  height: 88rpx;           /* 原系统导航栏内容区高度（44px） */
  box-sizing: content-box; /* 状态栏高度作为 padding 叠加在上方，不计入该高度 */
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-bottom: 8rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #d4af37;
  letter-spacing: 2rpx;
  text-align: center;
}

/* 顶部标题与副标题 */
.header-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.subtitle {
  font-size: 22rpx;
  color: #888899;
  margin-bottom: 6rpx;
  text-align: center;
}

/* 综合状态栏：时间 · 速度 · 方向 */
.status-line {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 26rpx;
  margin-bottom: 8rpx;
  letter-spacing: 1rpx;
}
.status-time { color: #e74c3c; font-weight: bold; }
.status-speed { color: #50e3c2; font-weight: bold; }
.status-dir { color: #d4af37; font-weight: bold; }
.status-sep { color: #555566; font-weight: normal; }

.direction-mark {
  font-size: 22rpx;
  color: #c8b88a;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
  text-align: center;
}

/* Tab 模式切换 */
.tab-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 12rpx;
  justify-content: center;
}

.tab-btn {
  background: #1c1d28;
  color: #888899;
  border: 1px solid #333446;
  padding: 10rpx 24rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  transition: all 0.2s ease;
}

.tab-btn.active {
  background: #d4af37;
  color: #111111;
  border-color: #d4af37;
  font-weight: bold;
}

.tab-btn.fn { font-weight: bold; }
.tab-btn.fn-gold { color: #f1c40f; border-color: #534321; }
.tab-btn.fn-cyan { color: #50e3c2; border-color: #1f4f45; }
.tab-btn.fn-locked {
  background: #e67e22 !important;
  color: #ffffff !important;
  border-color: #d35400 !important;
  box-shadow: 0 0 10rpx rgba(230, 126, 34, 0.7);
}

/* 分享按钮：button 组件有大量默认样式，需逐项重置以与相邻 .tab-btn 视觉对齐 */
.tab-btn.fn-share {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 10rpx 24rpx;
  line-height: 1.2;
  font-size: 24rpx;
  font-weight: bold;
  color: #7fb3ff;
  background: #1c1d28;
  border: 1px solid #2a3f5f;
  border-radius: 12rpx;
  overflow: visible;
}

/* 去掉 button 默认的 ::after 边框 */
.tab-btn.fn-share::after {
  border: none;
}

/* 罗盘朝向微光胶囊栏 */
.compass-bar {
  display: flex;
  margin-bottom: 12rpx;
  justify-content: center;
  align-items: center;
  width: 100%;
}

.compass-info-box {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  background: rgba(28, 29, 40, 0.85);
  border: 1px solid rgba(46, 204, 113, 0.45);
  color: #2ecc71;
  padding: 8rpx 20rpx;
  border-radius: 40rpx;
  font-size: 22rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.35);
}

.calib-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  display: inline-block;
  background: #2ecc71;
  box-shadow: 0 0 12rpx #2ecc71;
}
.calib-dot.med { background: #f39c12; box-shadow: 0 0 12rpx #f39c12; }
.calib-dot.low { background: #e74c3c; box-shadow: 0 0 12rpx #e74c3c; }

.compass-info-mag { color: #2ecc71; }
.compass-info-divider { color: #555566; }
.compass-info-true { color: #f1c40f; }
.compass-info-decl { color: #888899; font-size: 20rpx; }

/* 强磁干扰悬浮告警条 */
.mag-alert-banner {
  width: 100%;
  background: #3d1717;
  border: 1px solid #e74c3c;
  color: #ff6b6b;
  font-size: 22rpx;
  font-weight: bold;
  text-align: center;
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

/* 罗盘视口与 Canvas 容器 */
.compass-container {
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 10rpx 0 20rpx;
  width: 100%;
}

.compass-viewport {
  /* 对齐 Android 版 min(96vw, 500px) 的放大视口 */
  width: 700rpx;
  height: 700rpx;
  position: relative;
  overflow: hidden;
  border-radius: 50%;
  background-color: #1a1a24;
  box-shadow: 0 0 60rpx rgba(0, 0, 0, 0.85), 0 0 28rpx rgba(212, 175, 55, 0.35);
}

.compass-canvas {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 50%;
}

/* 十字天心瞄准线（坐向同论） */
.crosshair-vertical {
  position: absolute;
  left: 50%;
  top: 0;
  bottom: 0;
  width: 2rpx;
  background: linear-gradient(to bottom,
    rgba(231, 76, 60, 0.9) 0%, rgba(231, 76, 60, 0.2) 50%, rgba(231, 76, 60, 0.9) 100%);
  transform: translateX(-50%);
  pointer-events: none;
  z-index: 5;
}

.crosshair-horizontal {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  height: 2rpx;
  background: linear-gradient(to right,
    rgba(231, 76, 60, 0.9) 0%, rgba(231, 76, 60, 0.2) 50%, rgba(231, 76, 60, 0.9) 100%);
  transform: translateY(-50%);
  pointer-events: none;
  z-index: 5;
}

.crosshair-front-pointer {
  position: absolute;
  top: 6rpx;
  left: 50%;
  transform: translateX(-50%);
  color: #ff5252;
  font-size: 20rpx;
  font-weight: bold;
  background: rgba(22, 23, 32, 0.88);
  border: 1px solid rgba(231, 76, 60, 0.85);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  pointer-events: none;
  z-index: 6;
  line-height: 1.3;
}

.crosshair-back-pointer {
  position: absolute;
  bottom: 6rpx;
  left: 50%;
  transform: translateX(-50%);
  color: #50e3c2;
  font-size: 20rpx;
  font-weight: bold;
  background: rgba(22, 23, 32, 0.88);
  border: 1px solid rgba(80, 227, 194, 0.85);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  pointer-events: none;
  z-index: 6;
  line-height: 1.3;
}

/* 底部卦象解释面板 */
.info-panel {
  background: #1c1d28;
  border: 1px solid #333446;
  border-radius: 20rpx;
  padding: 30rpx;
  width: 700rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.5);
  margin-bottom: 30rpx;
}

.info-title {
  font-size: 30rpx;
  color: #d4af37;
  border-bottom: 1px solid #333446;
  padding-bottom: 16rpx;
  margin-bottom: 16rpx;
  font-weight: bold;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
  font-size: 24rpx;
}

.info-item-clickable {
  border-radius: 8rpx;
  padding: 8rpx 10rpx;
  margin: -8rpx -10rpx 12rpx -10rpx;
  background: rgba(212, 175, 55, 0.08);
}

.info-hint-icon {
  font-size: 18rpx;
  color: #d4af37;
  background: rgba(212, 175, 55, 0.18);
  border: 1px solid rgba(212, 175, 55, 0.4);
  border-radius: 50%;
  width: 26rpx;
  height: 26rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-left: 8rpx;
  font-weight: bold;
}

.info-label { color: #888899; }
.info-val { color: #ffffff; font-weight: 500; }
.sub-desc { font-size: 20rpx; color: #888899; font-weight: normal; }

/* 空亡诊断徽标 */
.kw-badge {
  display: inline-block;
  padding: 2rpx 14rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: bold;
}
.kw-badge.pure { background: #153828; color: #2ecc71; border: 1px solid #2ecc71; }
.kw-badge.jian { background: #3d2f14; color: #f39c12; border: 1px solid #f39c12; }
.kw-badge.small_kw { background: #3d1717; color: #e74c3c; border: 1px solid #e74c3c; }
.kw-badge.big_kw { background: #5a0f0f; color: #ff5252; border: 1px solid #ff5252; }

/* 图例区域 */
.legend {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1px solid #2a2b3d;
  font-size: 20rpx;
  color: #888899;
  line-height: 1.6;
}
.legend-title { color: #cccccc; font-weight: bold; margin-bottom: 8rpx; }
.legend-row { margin-bottom: 4rpx; }

/* ==================== 通用弹窗 ==================== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.75);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
}

.modal-card {
  background: #1e1f2b;
  border: 1px solid #3c3e54;
  border-radius: 28rpx;
  width: 92vw;
  max-width: 640rpx;
  max-height: 85vh;
  overflow-y: auto;
  padding: 32rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.8);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  flex-shrink: 0;
}

.modal-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #d4af37;
}

.modal-close {
  font-size: 32rpx;
  color: #888888;
  padding: 8rpx;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
  flex-shrink: 0;
}

.modal-btn {
  flex: 1;
  background: #d4af37;
  color: #111111;
  font-weight: bold;
  border-radius: 16rpx;
  padding: 16rpx 0;
  font-size: 26rpx;
  line-height: 1.4;
}

/* 图层配置弹窗 */
.layer-preset-bar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.layer-preset-btn {
  flex: 1;
  background: #252636;
  border: 1px solid #3d3e55;
  color: #bbbbbb;
  font-size: 20rpx;
  padding: 10rpx 4rpx;
  border-radius: 10rpx;
  text-align: center;
}
.layer-preset-btn:active { background: #d4af37; color: #121216; font-weight: bold; }

.layer-item-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 16rpx;
  background: #181924;
  border: 1px solid #2a2c3e;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: #dddddd;
}

.layer-check { color: #d4af37; font-size: 28rpx; }

/* 详解弹窗实时状态卡片 */
.status-card {
  background: #181926;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  border: 1px solid #2e3046;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.status-card-col { display: flex; flex-direction: column; gap: 6rpx; }
.status-card-label { color: #aaaaaa; font-size: 20rpx; }
.status-card-strong { font-weight: bold; }

/* 详解卡片 */
.explain-box {
  background: #14151e;
  border: 1px solid #2d2e40;
  border-radius: 14rpx;
  padding: 18rpx;
  margin-bottom: 16rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #cccccc;
}

.explain-title {
  font-size: 24rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.explain-tag {
  display: inline-block;
  font-size: 18rpx;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
  font-weight: bold;
}

.explain-quote {
  background: rgba(212, 175, 55, 0.08);
  border-left: 3px solid #d4af37;
  padding: 14rpx 20rpx;
  font-size: 20rpx;
  color: #ffd166;
  margin: 16rpx 0;
  border-radius: 0 10rpx 10rpx 0;
  line-height: 1.7;
}

/* ==================== 居家风水：实时方位速查卡片 ==================== */
.fs-live-card {
  width: 100%;
  margin: 12rpx 0;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  background: linear-gradient(135deg, rgba(28, 30, 42, 0.95), rgba(18, 19, 28, 0.98));
  border: 1px solid #5a4622;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.4), inset 0 0 14rpx rgba(212, 175, 55, 0.05);
}

.fs-live-header {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.fs-live-badge {
  font-size: 23rpx;
  font-weight: bold;
  color: #d4af37;
}

.fs-live-role {
  flex: 1;
  font-size: 20rpx;
  color: #50e3c2;
}

.fs-live-btn {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: bold;
  color: #f39c12;
}

.fs-live-body {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.fs-live-row {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
}

.fs-pill {
  flex-shrink: 0;
  font-size: 19rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  line-height: 1.5;
  border: 1px solid;
}

.fs-pill.warn {
  background: #3d1717;
  color: #ff7675;
  border-color: #8e2b2b;
}

.fs-pill.layout {
  background: #14352b;
  color: #50e3c2;
  border-color: #1f6b55;
}

.fs-live-text {
  flex: 1;
  font-size: 21rpx;
  color: #bbbbbb;
  line-height: 1.5;
}

/* ==================== 居家风水八方详勘弹窗 ==================== */
.fs-modal-card {
  width: 92vw;
  height: 88vh;
  max-height: 88vh;
  display: flex;
  flex-direction: column;
  /* 外层卡片自身不滚动，避免与内部详情 scroll-view 形成嵌套滚动冲突；
     给定确定高度后，内部 flex:1 的详情区才能正确计算滚动高度 */
  overflow: hidden;
}

.fs-tabs-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 16rpx;
  flex-shrink: 0;
  /* 独立背景 + 抬升层级，确保不与下方详情内容重叠 */
  background: #1e1f2b;
  position: relative;
  z-index: 2;
}

.fs-tabs-inner {
  display: inline-flex;
  gap: 10rpx;
  padding: 2rpx 0;
}

.fs-tab-item {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  font-size: 22rpx;
  color: #888899;
  background: #1c1d28;
  border: 1px solid #333446;
  border-radius: 12rpx;
}

.fs-tab-item.active {
  background: #d4af37;
  color: #111111;
  border-color: #d4af37;
  font-weight: bold;
}

.fs-detail-scroll {
  flex: 1;
  min-height: 0;
}

/* 概览四宫格：用 flex 换行而非 grid，兼容性更稳妥 */
.fs-meta-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.fs-meta-item {
  width: calc(50% - 6rpx);
  box-sizing: border-box;
  background: #14151e;
  border: 1px solid #2d2e40;
  border-radius: 10rpx;
  padding: 12rpx;
}

.fs-meta-lbl {
  display: block;
  font-size: 19rpx;
  color: #888899;
  margin-bottom: 4rpx;
}

.fs-meta-val {
  display: block;
  font-size: 21rpx;
  font-weight: bold;
  line-height: 1.4;
}

.fs-detail-card {
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 14rpx;
  background: #14151e;
  border: 1px solid #2d2e40;
}

.fs-detail-card.warn-card { border-left: 4rpx solid #e74c3c; }
.fs-detail-card.layout-card { border-left: 4rpx solid #2ecc71; }
.fs-detail-card.remedy-card { border-left: 4rpx solid #f1c40f; }

.fs-card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.fs-card-title {
  flex: 1;
  font-size: 23rpx;
  font-weight: bold;
  line-height: 1.4;
}

.fs-card-title.warn-title { color: #ff7675; }
.fs-card-title.layout-title { color: #50e3c2; }
.fs-card-title.remedy-title { color: #f1c40f; }

.fs-list-item {
  font-size: 21rpx;
  color: #cccccc;
  line-height: 1.65;
  margin-bottom: 8rpx;
}

.bold { font-weight: bold; color: #ffffff; }
